# LLM provider URL
# Local (Ollama):  LLM_URL=http://localhost:11434
# MiniMax:         LLM_URL=https://api.minimax.chat
# OpenAI:          LLM_URL=https://api.openai.com
LLM_URL=http://localhost:11434

# LLM API key (leave as "ollama" for local Ollama, set your key for cloud providers)
LLM_API_KEY=ollama

# OpenWeatherMap API Key (Weather/Climate Data)
# Register at: https://openweathermap.org/api (free tier available)
OWM_API_KEY=

# OpenRouteService API Key (Route Optimization)
# Register at: https://openrouteservice.org (free tier, requires registration)
ORS_API_KEY=

# Optional: if set, inventory reads from Postgres; otherwise falls back to in-memory mock
# DATABASE_URL=postgresql://scuser:scpass@localhost:5432/supply_chain
